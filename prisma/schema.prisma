generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model allergens {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                 @unique @db.VarChar(50)
  description          String?
  ingredient_allergens ingredient_allergens[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dish_review_analysis {
  id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  review_id            String                      @unique @db.Uuid
  status               review_analysis_status_enum @default(pending)
  confidence_score     Decimal?                    @db.Decimal(5, 4)
  reason               String?
  model_version        String?                     @db.VarChar(50)
  reviewed_by_admin_id String?                     @db.Uuid
  manual_override      Boolean                     @default(false)
  analyzed_at          DateTime?                   @db.Timestamptz(6)
  dish_reviews         dish_reviews                @relation(fields: [review_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                users?                      @relation(fields: [reviewed_by_admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reviewed_by_admin_id], map: "idx_dish_review_analysis_admin")
  @@index([status], map: "idx_dish_review_analysis_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dish_reviews {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id          String                @db.Uuid
  order_item_id        String                @unique @db.Uuid
  menu_item_id         String                @db.Uuid
  rating               Int
  comment              String?
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime              @default(now()) @db.Timestamptz(6)
  dish_review_analysis dish_review_analysis?
  users                users                 @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  menu_items           menu_items            @relation(fields: [menu_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order_items          order_items           @relation(fields: [order_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customer_id], map: "idx_dish_reviews_customer")
  @@index([menu_item_id], map: "idx_dish_reviews_menu_item")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model floor_plans {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id     String              @unique(map: "one_default_floor_plan_per_restaurant", where: raw("(is_default AND is_active)")) @db.Uuid
  name              String              @db.VarChar(100)
  canvas_width      Int
  canvas_height     Int
  background_url    String?
  is_default        Boolean             @default(false)
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  restaurants       restaurants         @relation(fields: [restaurant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  restaurant_tables restaurant_tables[]

  @@unique([id, restaurant_id])
  @@unique([restaurant_id, name])
}

