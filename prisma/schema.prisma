  longitude         Decimal?            @db.Decimal(9, 6)
  phone             String?             @db.VarChar(20)
  opening_time      DateTime            @db.Time(6)
  closing_time      DateTime            @db.Time(6)
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  floor_plans       floor_plans?
  inventory_items   inventory_items[]
  menu_categories   menu_categories[]
  orders            orders[]
  reservations      reservations[]
  restaurant_tables restaurant_tables[]
  staff             staff[]
  table_categories  table_categories[]
}

model staff {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String                   @unique @db.Uuid
  restaurant_id          String                   @db.Uuid
  staff_type             staff_type_enum
  position               String?                  @db.VarChar(50)
  is_available           Boolean                  @default(true)
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  inventory_transactions inventory_transactions[]
  order_item_assignments order_item_assignments[]
  orders                 orders[]
  payments               payments[]
  refunds                refunds[]
  restaurants            restaurants              @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                  users                    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff_specializations  staff_specializations[]
  table_assignments      table_assignments[]

  @@index([restaurant_id, staff_type], map: "idx_staff_restaurant")
}

model staff_specializations {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id             String               @db.Uuid
  specialization_id    String               @db.Uuid
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  food_specializations food_specializations @relation(fields: [specialization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff                staff                @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([staff_id, specialization_id])
  @@index([specialization_id], map: "idx_staff_specializations_spec")
}

model table_assignments {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  table_id          String                       @unique(map: "one_active_staff_per_table", where: raw("(status = 'assigned'::table_assignment_status_enum)")) @db.Uuid
  staff_id          String                       @db.Uuid
  status            table_assignment_status_enum @default(assigned)
  assigned_at       DateTime                     @default(now()) @db.Timestamptz(6)
  released_at       DateTime?                    @db.Timestamptz(6)
  staff             staff                        @relation(fields: [staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  restaurant_tables restaurant_tables            @relation(fields: [table_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([staff_id], map: "idx_table_assignments_staff")
  @@index([table_id], map: "idx_table_assignments_table")
}

model table_categories {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id     String              @db.Uuid
  name              String              @db.VarChar(50)
  description       String?
  display_order     Int                 @default(0)
  is_active         Boolean             @default(true)
  restaurant_tables restaurant_tables[]
  restaurants       restaurants         @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([restaurant_id, name])
}

